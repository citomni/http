# Normalize text files unless overridden below.
* text=auto

# Core project files.
*.php text eol=lf
*.md text eol=lf
*.json text eol=lf
*.lock text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.neon text eol=lf
*.ini text eol=lf
*.env.example text eol=lf

# Web and template files.
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.svg text eol=lf
*.tpl text eol=lf
*.stub text eol=lf
.htaccess text eol=lf

# Shell and CLI files.
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Git placeholders.
.gitkeep text eol=lf

# Binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.phar binary